# ============================================================================
# Auto-Insight — Environment Variables
# ============================================================================
# Copy this file to .env and fill in the values for your environment.
#
#   cp .env.example .env
#
# ============================================================================

# ── Email (Resend) ──────────────────────────────────────────────────────
# Required for password reset emails and notifications.
# Get your API key at https://resend.com
RESEND_API_KEY=
RESEND_FROM=onboarding@resend.dev

# ── AI Translation (DeepL) ──────────────────────────────────────────────
# Required for automatic content translation feature.
# Get your API key at https://www.deepl.com/pro-api
DEEPL_API_KEY=

# ── Frontend ────────────────────────────────────────────────────────────
# URL where the frontend is accessed (used for password reset links in emails).
# Default is fine for local development.
FRONTEND_URL=http://localhost:3000

# ── Branding ────────────────────────────────────────────────────────────
# Logo URL for email templates. Leave empty to use text-only fallback.
LOGO_URL=

# ── Security ────────────────────────────────────────────────────────────
# JWT signing secret. CHANGE THIS in production.
# Default for local dev: "change-me-in-production"
JWT_SECRET=change-me-in-production
